---
// Model Hub mark — a hub node routing to five modality satellites.
const size = Astro.props.size ?? 32;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Model Hub"
>
  <rect x="3" y="3" width="26" height="26" rx="6" fill="var(--steel-900)" stroke="var(--steel-500)" />
  <!-- spokes -->
  <path d="M16 16L9 10" stroke="var(--data)" stroke-width="1.4" stroke-linecap="round" opacity="0.9" />
  <path d="M16 16L23 10" stroke="var(--data)" stroke-width="1.4" stroke-linecap="round" opacity="0.65" />
  <path d="M16 16L8.5 17.5" stroke="var(--data)" stroke-width="1.4" stroke-linecap="round" opacity="0.5" />
  <path d="M16 16L23.5 17.5" stroke="var(--data)" stroke-width="1.4" stroke-linecap="round" opacity="0.4" />
  <path d="M16 16L16 23" stroke="var(--data)" stroke-width="1.4" stroke-linecap="round" opacity="0.55" />
  <!-- satellites: five modalities -->
  <circle cx="9" cy="10" r="1.7" fill="var(--data)" />
  <circle cx="23" cy="10" r="1.7" fill="var(--plasma)" />
  <circle cx="8.5" cy="17.5" r="1.7" fill="var(--ok)" />
  <circle cx="23.5" cy="17.5" r="1.7" fill="var(--warn)" />
  <circle cx="16" cy="23" r="1.7" fill="var(--data)" opacity="0.8" />
  <!-- hub -->
  <rect x="13.4" y="13.4" width="5.2" height="5.2" rx="1.4" fill="var(--power)" />
</svg>
