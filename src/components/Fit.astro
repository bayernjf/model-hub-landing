---
import { getLangFromUrl, useTranslations } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fits = [
  { title: t("fit.1.t"), desc: t("fit.1.d") },
  { title: t("fit.2.t"), desc: t("fit.2.d") },
  { title: t("fit.3.t"), desc: t("fit.3.d") },
  { title: t("fit.4.t"), desc: t("fit.4.d") },
];
---

<section class="fit" id="fit">
  <div class="shell">
    <p class="kicker">{t("fit.kicker")}</p>
    <h2 class="fit__title">{t("fit.title")}</h2>
    <p class="fit__sub">{t("fit.sub")}</p>
    <div class="fit__grid">
      {
        fits.map((f) => (
          <article class="fit__card">
            <span class="fit__tick" aria-hidden="true" />
            <h3 class="fit__name">{f.title}</h3>
            <p class="fit__desc">{f.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fit {
    padding: 56px 0;
  }
  .fit__title {
    margin-top: 14px;
    font-size: clamp(26px, 3.6vw, 40px);
  }
  .fit__sub {
    margin-top: 12px;
    color: var(--ink-dim);
    max-width: 640px;
  }
  .fit__grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .fit__card {
    position: relative;
    padding: 24px 22px 22px 54px;
    border: var(--hair);
    border-radius: 10px;
    background: var(--steel-850);
  }
  .fit__tick {
    position: absolute;
    left: 22px;
    top: 26px;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--data-dim);
    box-shadow: inset 0 0 0 2px var(--data);
  }
  .fit__name {
    font-size: 17px;
  }
  .fit__desc {
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--ink-dim);
  }
  @media (max-width: 760px) {
    .fit__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
