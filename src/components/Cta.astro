---
import { getLangFromUrl, useTranslations } from "../i18n";
import { SOCIAL } from "../consts";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="cta" id="cta">
  <div class="shell">
    <div class="panel cta__panel">
      <div class="cta__copy">
        <h2 class="cta__title">{t("cta.title")}</h2>
        <p class="cta__sub">{t("cta.sub")}</p>
        <pre class="cta__snippet"><code>{t("cta.snippet")}</code></pre>
      </div>
      <div class="cta__actions">
        <a class="btn btn--primary" href={SOCIAL.github} target="_blank" rel="noopener noreferrer">
          {t("cta.primary")}
        </a>
        <a
          class="btn btn--ghost"
          href={`${SOCIAL.github}#readme`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("cta.secondary")}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 56px 0 80px;
  }
  .cta__panel {
    padding: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    background:
      radial-gradient(circle at 88% 15%, rgba(53, 224, 240, 0.09), transparent 45%),
      var(--steel-900);
  }
  .cta__copy {
    flex: 1 1 340px;
    /* let the item shrink past the snippet's min-content width, otherwise
       the unbroken command line forces horizontal overflow at 375px */
    min-width: 0;
  }
  .cta__title {
    font-size: clamp(24px, 3vw, 34px);
  }
  .cta__sub {
    margin-top: 10px;
    color: var(--ink-dim);
    max-width: 520px;
  }
  .cta__snippet {
    margin: 18px 0 0;
    padding: 12px 16px;
    display: inline-block;
    max-width: 100%;
    overflow-x: auto;
    border: var(--hair);
    border-radius: 8px;
    background: var(--steel-950);
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--data);
  }
  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 0 0 auto;
  }
  @media (max-width: 640px) {
    .cta__panel {
      padding: 28px 22px;
    }
    .cta__snippet {
      /* on narrow screens wrap the command instead of scrolling it */
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .cta__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
